// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ROLE {
  USER
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum OrganizationRole {
  USER
  ADMIN
  MANAGER
  TECHNICIAN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum JobType {
  MAINTENANCE
  INSPECTION
  REPAIR
  INSTALLATION
  CLEANING
  OTHER
}

enum JobStatus {
  REQUESTED
  PENDING
  ACCEPTED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  REJECTED
  CANCELLED
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum JobScheduleType {
  ASAP
  SCHEDULED
  RECURRING
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  COMPLETED
}

enum ChecklistItemStatus {
  PENDING
  COMPLETED
  SKIPPED
}

model User {
  user_id    String  @id @default(uuid())
  email      String  @unique
  firstName  String
  middleName String?
  lastName   String
  password   String
  avatar_url String?
  role       ROLE    @default(USER)

  addresses               Address[]
  organizationMemberships OrganizationMembership[]
  jobs                    Job[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

model Address {
  address_id   String   @id @default(uuid())
  label        String? // Home, Work,
  fullName     String?
  phone        String?
  addressLine1 String
  lat          Decimal?
  long         Decimal?
  addressLine2 String?
  city         String
  state        String?
  postalCode   String?
  country      String
  userId       String

  isDefault Boolean @default(false)

  user      User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Organization {
  id                 String           @id @default(uuid())
  slug               String           @unique
  orgName            String           @map("org_name")
  description        String?
  industryCategoryId String
  industryCategory   IndustryCategory @relation(fields: [industryCategoryId], references: [id], onDelete: Cascade)

  timeZone String @default("UTC")
  currency String @default("USD") @db.VarChar(3)
  locale   String @default("en-US")

  status                  OrganizationStatus       @default(ACTIVE)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organizationMemberships OrganizationMembership[]
  jobs                    Job[]

  @@index([id, slug, status])
}

model IndustryCategory {
  id            String         @id @default(uuid())
  name          String
  organizations Organization[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(USER)
  joinedAt       DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Job {
  id String @id() @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // job info
  jobNumber   String
  title       String
  description String?     @db.Text
  type        JobType
  status      JobStatus   @default(REQUESTED)
  priority    JobPriority @default(MEDIUM)

  // Scheduling
  scheduleType JobScheduleType @default(ASAP)
  scheduledAt  DateTime?
  dueAt        DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  customerNotes String?
  internalNotes String?

  // customer info
  customerId String?
  customer   User?   @relation(fields: [customerId], references: [user_id])

  checklists JobChecklistItem[]
}

model JobChecklistItem {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      ChecklistItemStatus @default(PENDING)

  isRequired Boolean @default(true)
  sortOrder  Int     @default(0)

  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, sortOrder])
}
